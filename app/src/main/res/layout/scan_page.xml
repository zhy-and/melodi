<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@mipmap/home_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    >
    <include android:id="@+id/title"
        layout="@layout/main_include" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        android:id="@+id/container"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/top_bg"
            android:src="@mipmap/scan_bg"
            android:scaleType="fitXY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <ImageView
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/scan_start"
            android:src="@mipmap/scan_start"
            android:scaleType="fitXY"
            android:layout_width="200dp"
            android:layout_height="200dp"/>

        <com.airbnb.lottie.LottieAnimationView
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/music"
            android:layout_width="330dp"
            app:lottie_imageAssetsFolder="images"
            app:lottie_loop="true"
            app:lottie_fileName="scan.json"
            app:lottie_autoPlay="true"
            android:layout_height="330dp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/scan"
        android:layout_marginTop="77dp"
        android:layout_marginHorizontal="58dp"
        android:layout_width="match_parent"
        android:text="Start"
        android:gravity="center"
        android:background="@drawable/feed_btn_shape"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@id/container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>