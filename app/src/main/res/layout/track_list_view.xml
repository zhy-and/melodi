<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@mipmap/home_bg"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">
    <include android:id="@+id/include_titles"
        layout="@layout/main_include" />
    <androidx.core.widget.NestedScrollView
        app:layout_constraintTop_toBottomOf="@id/include_titles"
        app:layout_constraintBottom_toTopOf="@id/bottom_music"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_marginHorizontal="16dp"
                android:id="@+id/top_index"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:visibility="gone"
                    android:gravity="center"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:id="@+id/rl_track"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_centerHorizontal="true"
                        android:id="@+id/sl_text"
                        android:src="@mipmap/home_tracks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_below="@id/sl_text"
                        android:layout_centerHorizontal="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tracks"
                        android:textColor="#808080"
                        android:textSize="12sp"
                        />
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:id="@+id/rl_play_list"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_centerHorizontal="true"
                        android:id="@+id/url"
                        android:src="@mipmap/home_playlists"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
android:visibility="gone"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@id/url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Playlists"
                        android:textColor="#808080"
                        android:textSize="12sp"
                        />
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:id="@+id/rl_albums"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_centerHorizontal="true"
                        android:id="@+id/albums"
                        android:src="@mipmap/home_albums"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:visibility="gone"

                        android:layout_centerHorizontal="true"
                        android:layout_below="@id/albums"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Albums"
                        android:textColor="#808080"
                        android:textSize="12sp"
                        />
                </RelativeLayout>

                <RelativeLayout
                    android:gravity="center"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:id="@+id/rl_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_centerHorizontal="true"
                        android:id="@+id/artist"
                        android:src="@mipmap/home_artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:visibility="gone"

                        android:layout_centerHorizontal="true"
                        android:layout_below="@id/artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Artists"
                        android:textColor="#808080"
                        android:textSize="12sp"
                        />
                </RelativeLayout>

                <RelativeLayout
                    android:gravity="center"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:id="@+id/rl_styles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_centerHorizontal="true"
                        android:id="@+id/styles"
                        android:src="@mipmap/home_styles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:visibility="gone"

                        android:layout_centerHorizontal="true"
                        android:layout_below="@id/styles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Styles"
                        android:textColor="#808080"
                        android:textSize="12sp"
                        />
                </RelativeLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <TextView
                android:id="@+id/for_titles"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trending Playlists"
                android:textColor="#FFFFFFFF"
                app:layout_constraintTop_toBottomOf="@id/top_index"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="15dp"
                android:textSize="16sp"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/for_titles"
                android:id="@+id/content"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/albums_tw"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="5dp"
                    android:id="@+id/albums_one"
                    android:paddingBottom="6dp"
                    app:layout_constraintDimensionRatio="107:107"
                    android:background="@mipmap/play_ones"
                    android:layout_width="0dp"
                    android:layout_height="0dp">
                    <TextView
                        android:tag="-1"
                        android:id="@+id/al1_txt"
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:lines="1"
                        android:text="Lost in the Rhythm"
                        android:layout_width="80dp"
                        android:ellipsize="end"
                        android:layout_marginHorizontal="10dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/albums_one"
                    app:layout_constraintHorizontal_weight="1"
                    android:layout_marginHorizontal="5dp"
                    app:layout_constraintEnd_toStartOf="@id/albums_thr"
                    android:id="@+id/albums_tw"
                    android:paddingBottom="6dp"
                    android:background="@mipmap/play_tws"
                    android:layout_width="0dp"
                    app:layout_constraintDimensionRatio="107:107"
                    android:layout_height="0dp">

                    <TextView
                        android:id="@+id/al2_txt"
                        android:tag="-1"
                        android:gravity="center"
                        android:lines="1"
                        android:layout_width="80dp"
                        android:text="Golden Hour Groove"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:ellipsize="end"
                        android:layout_marginHorizontal="10dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_marginStart="5dp"
                    android:id="@+id/albums_thr"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/albums_tw"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    android:paddingBottom="6dp"
                    android:background="@mipmap/play_thrs"
                    android:layout_width="0dp"
                    app:layout_constraintDimensionRatio="107:107"
                    android:layout_height="0dp">

                    <TextView
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:tag="-1"
                        android:id="@+id/al3_txt"
                        android:gravity="center"
                        android:lines="1"
                        android:layout_width="80dp"
                        android:text="Moonlit Chill "
                        android:ellipsize="end"
                        android:layout_marginHorizontal="10dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/home_content_ads"
                android:layout_marginHorizontal="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.extraordinary.interstings.studios.goodads.CommonWeavesView
                    android:layout_marginTop="25dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/home_bans"
                    android:layout_width="match_parent"
                    app:gnt_template_type="@layout/top_view_home_ban"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/for_title"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Tracks"
                android:textColor="#FFFFFFFF"
                app:layout_constraintTop_toBottomOf="@id/home_content_ads"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="15dp"
                android:textSize="16sp"
                />
            <androidx.appcompat.widget.LinearLayoutCompat
                android:visibility="gone"
                android:paddingVertical="24dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@drawable/lyric_shape"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/for_title"
                android:layout_centerHorizontal="true"
                android:id="@+id/no_permission_pic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="Permission Required"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    />
                <TextView
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Please grant XXX Music Player music access."
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    />
                <TextView
                    android:id="@+id/scan"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="76dp"
                    android:layout_width="match_parent"
                    android:text="Allow"
                    android:gravity="center"
                    android:background="@drawable/feed_btn_shape"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_height="48dp"
                    app:layout_constraintTop_toBottomOf="@id/container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/for_title"
                android:id="@+id/no_content_pic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/empty_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/add_music"
                    />
                <TextView
                    android:id="@+id/btn_feed"
                    android:layout_marginTop="24dp"
                    android:layout_marginHorizontal="92dp"
                    android:layout_width="match_parent"
                    android:text="No music files"
                    android:gravity="center"
                    android:textColor="#808080"
                    android:textSize="16sp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/empty_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginBottom="15dp"
                app:layout_constraintTop_toBottomOf="@id/for_title"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/recycle_hislist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:background="#D9FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/bottom_music"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            >
            <com.airbnb.lottie.LottieAnimationView
                android:layout_marginStart="-20dp"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/music"
                android:layout_width="wrap_content"
                app:lottie_imageAssetsFolder="images"
                app:lottie_loop="true"
                app:lottie_fileName="play.json"
                android:layout_height="wrap_content"
                />
            <com.extraordinary.weaves.tendency.MarqueeTextView
                android:layout_centerVertical="true"
                android:layout_marginStart="-30dp"
                android:layout_toEndOf="@id/music"
                android:text="@string/app_name"

                android:id="@+id/tv_home_bottom_music_name"
                android:layout_width="wrap_content"
                android:layout_marginEnd="15dp"
                android:ellipsize="end"
                android:layout_toStartOf="@id/fl_home_bottom_play_pause"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:textColor="@color/black" />

            <ImageView
                android:layout_marginEnd="24dp"
                android:id="@+id/btn_home_bottom_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@mipmap/ic_bottom_bar_playlist"
                />



            <RelativeLayout
                android:padding="5dp"
                android:id="@+id/fl_home_bottom_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:layout_toStartOf="@id/btn_home_bottom_menu">

                <ImageView
                    android:visibility="gone"
                    android:layout_centerVertical="true"
                    android:id="@+id/btn_home_bottom_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_bottom_bar_pause"/>

                <ImageView
                    android:layout_centerVertical="true"
                    android:id="@+id/btn_home_bottom_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_bottom_bar_play"
                    />
            </RelativeLayout>

        </RelativeLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
