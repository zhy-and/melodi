<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sliding_content"
    android:background="@mipmap/home_bg"
    android:layout_width="match_parent"
    android:clipToPadding="true"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/tops"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@mipmap/song_bg"
        app:layout_constraintBottom_toBottomOf="@id/top_ivg"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:fitsSystemWindows="true"
        android:id="@+id/top_ivg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="172dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            >

            <ImageView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="16dp"
                android:id="@+id/back_btn"
                android:src="@mipmap/back_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <TextView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/title_content"
                android:textStyle="bold"
                android:layout_centerInParent="true"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <ImageView
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="20dp"
                android:src="@mipmap/ic_launcher"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/search_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


        </androidx.constraintlayout.widget.ConstraintLayout>



        <RelativeLayout
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView

                android:id="@+id/tv_music_play_cur_time"
                android:layout_width="wrap_content"
                android:gravity="center_horizontal"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:text="00:00"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                />


            <TextView
                android:textSize="12sp"
                android:layout_alignParentEnd="true"
                android:id="@+id/tv_music_play_total_time"
                android:layout_width="wrap_content"
                android:gravity="center_horizontal"
                android:layout_height="wrap_content"
                android:layout_marginRight="17dp"
                android:text="00:00"
                android:textColor="@android:color/white"
                />
        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/lines"
        android:background="#26CC6A"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_ivg"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <SeekBar
        app:layout_constraintTop_toTopOf="@id/lines"
        app:layout_constraintBottom_toBottomOf="@id/lines"
        android:splitTrack="false"
        android:id="@+id/sb_music_play_playback"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:max="100"
        android:paddingEnd="0dp"
        android:minHeight="2dp"
        android:maxHeight="2dp"
        android:thumb="@mipmap/thumb"
        app:layout_constraintStart_toStartOf="parent"
        android:progressDrawable="@drawable/selector_player_seekbar"
        />

    <androidx.core.widget.NestedScrollView
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/sb_music_play_playback"
        app:layout_constraintBottom_toTopOf="@id/bottom_view"
        android:layout_width="match_parent"
        android:layout_height="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/home_content_ads"
                android:layout_marginHorizontal="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.extraordinary.interstings.studios.goodads.CommonWeavesView
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/home_bans"
                    android:layout_width="match_parent"
                    app:gnt_template_type="@layout/top_view_home_ban"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/bottom_view"
    android:background="@mipmap/song_bottom_bg"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_width="match_parent"
    app:layout_constraintDimensionRatio="375:321"
    android:layout_height="0dp">
    <TextView
        android:id="@+id/music_name"
        android:layout_width="wrap_content"
        android:gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:lines="1"
        android:ellipsize="end"
        android:text="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginRight="10dp"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"/>
    <TextView
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/music_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/music_singer"
        android:layout_width="wrap_content"
        android:lines="1"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:textColor="@android:color/white"
      />
    <TextView
        android:layout_marginTop="16dp"
        android:text="lyrics"
        android:id="@+id/lyric"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#26CC6A"
        android:gravity="center"
        android:layout_marginHorizontal="107dp"
        app:layout_constraintTop_toBottomOf="@id/music_singer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="160:40"
        android:layout_width="0dp"
        android:background="@drawable/btn_home_shape"
        android:layout_height="0dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="52dp"
        android:id="@+id/top_index"
        app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/lyric"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="center"
            android:layout_weight="1"
            android:id="@+id/rl_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_centerHorizontal="true"
                android:id="@+id/btn_music_play_mode"
                android:src="@mipmap/ic_playmode_random"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:layout_weight="1"
            android:id="@+id/rl_play_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_centerHorizontal="true"
                android:id="@+id/btn_music_play_favorite"
                android:src="@mipmap/ic_favorite_unchecked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>
        <RelativeLayout
            android:visibility="gone"
            android:gravity="center"
            android:layout_weight="1"
            android:id="@+id/rl_albums"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_centerHorizontal="true"
                android:id="@+id/albums"
                android:src="@mipmap/home_albums"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>

        <RelativeLayout
            android:gravity="center"
            android:layout_weight="1"
            android:id="@+id/rl_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_centerHorizontal="true"
                android:id="@+id/lock"
                android:src="@mipmap/lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>

        <RelativeLayout
            android:gravity="center"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:id="@+id/rl_styles"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_centerHorizontal="true"
                android:id="@+id/play_list"
                android:src="@mipmap/list_song"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginHorizontal="92dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/btn_music_play_prev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@mipmap/ic_player_prev" />

        <FrameLayout
            android:id="@+id/container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
           >

            <ImageView
                android:id="@+id/btn_music_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_player_pause"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btn_music_play_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_player_play" />
        </FrameLayout>

        <ImageView
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/btn_music_play_next"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_player_next" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>