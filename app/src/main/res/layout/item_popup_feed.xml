<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content">
    <LinearLayout
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="@drawable/pop_back"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/play_now"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:src="@mipmap/play_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play now"
                android:textColor="#000000"
                android:textSize="16sp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="13dp"
            android:orientation="horizontal"
            android:id="@+id/play_fav"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:src="@mipmap/play_collect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add to favourite"
                android:textColor="#000000"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="13dp"


            android:orientation="horizontal"
            android:id="@+id/play_album"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:src="@mipmap/play_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go to album"
                android:textColor="#000000"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="13dp"

            android:orientation="horizontal"
            android:id="@+id/play_art"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:src="@mipmap/play_art"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go to artist"
                android:textColor="#000000"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="13dp"
            android:orientation="horizontal"
            android:id="@+id/play_delete"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:src="@mipmap/play_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/pop_txt"
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remove from this queue"
                android:textColor="#000000"
                android:textSize="16sp"
                />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

