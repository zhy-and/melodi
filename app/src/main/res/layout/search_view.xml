<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@mipmap/home_bg"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    >
    <include android:id="@+id/title"
        layout="@layout/main_include" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginHorizontal="16dp"
        android:id="@+id/search_cl"
        android:background="@drawable/search_shap"
app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:layout_marginEnd="8dp"
            android:src="@mipmap/search_a"
            android:id="@+id/seach_start"
            android:layout_width="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            />
        <EditText
            android:layout_marginStart="8dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintStart_toEndOf="@id/seach_start"
            android:id="@+id/search_edit"
            app:layout_constraintEnd_toStartOf="@id/search_btns"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="0dp"
            android:hint="Search for tracks, artists, albums here."
            android:textColorHint="#808080"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:background="@null"
            android:layout_height="match_parent"/>

        <TextView
            android:layout_marginEnd="8dp"
            android:id="@+id/search_btns"
            android:layout_width="48dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="32dp"
            android:text="OK"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/black"
            android:background="@drawable/sear_ok"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home_content_ads"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.extraordinary.interstings.studios.goodads.CommonWeavesView
            android:layout_marginTop="25dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/home_bans"
            android:layout_width="match_parent"
            app:gnt_template_type="@layout/top_view_home_ban"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:visibility="gone"
        android:id="@+id/empty_search"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_content_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_marginHorizontal="16dp"
            android:id="@+id/top_index"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_track"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/sl_text"
                    android:src="@mipmap/s_track"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_below="@id/sl_text"
                    android:layout_centerHorizontal="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tracks"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_marginHorizontal="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_play_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/url"
                    android:src="@mipmap/s_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playlists"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_albums"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/albums"
                    android:src="@mipmap/s_albums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/albums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Albums"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    />
            </RelativeLayout>

            <RelativeLayout
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_artist"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/artist"
                    android:src="@mipmap/s_art"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Artists"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    />
            </RelativeLayout>

            <RelativeLayout
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_styles"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/styles"
                    android:src="@mipmap/s_styles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/styles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Styles"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    />
            </RelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <ImageView
            android:layout_marginTop="48dp"
            android:src="@mipmap/empty_s"
            android:id="@+id/empty_btn"
            android:layout_width="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/top_index"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <TextView
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/empty_btn"
            android:layout_width="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="wrap_content"
            android:text="No files in the local yet"
            android:textColor="#FF808080"
            android:textSize="16sp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:visibility="gone"
        android:id="@+id/all_result"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_content_ads"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginHorizontal="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/tracks_se"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tracks"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/tracks_se"
                android:id="@+id/recycle_track_list"
                android:layout_width="match_parent"
                android:layout_height="150dp"/>


            <TextView
                app:layout_constraintTop_toBottomOf="@id/recycle_track_list"
                android:layout_marginTop="15dp"
                android:id="@+id/albums_se"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Albums"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/albums_se"
                android:id="@+id/recycle_album_list"
                android:layout_width="match_parent"
                android:layout_height="150dp"/>



            <TextView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/recycle_album_list"
                android:layout_marginTop="15dp"
                android:id="@+id/artists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artists"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/artists"
                android:id="@+id/recycle_art_list"
                android:layout_width="match_parent"
                android:layout_height="150dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>