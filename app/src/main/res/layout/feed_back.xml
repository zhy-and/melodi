<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@mipmap/home_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    >
    <include android:id="@+id/title"
        layout="@layout/main_include" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="16dp"
        android:id="@+id/container"
        android:background="@drawable/feed_shape"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:layout_width="match_parent"
        android:layout_height="398dp">
        <View
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/gra_shape"
            android:layout_width="match_parent"
            android:layout_height="100dp"/>
        <EditText
         android:layout_margin="16dp"
            android:gravity="top"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/search_edit"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:hint="Enter your feedback here."
            android:textColorHint="#808080"
            android:textSize="14sp"
            android:background="@null"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/btn_feed"
        android:layout_marginTop="77dp"
        android:layout_marginHorizontal="58dp"
        android:layout_width="match_parent"
        android:text="OK"
        android:gravity="center"
        android:background="@drawable/feed_btn_shape"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@id/container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>