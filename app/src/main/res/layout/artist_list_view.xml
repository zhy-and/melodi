<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@mipmap/home_bg"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">
    <include android:id="@+id/include_titles"
        layout="@layout/main_include" />
    <androidx.core.widget.NestedScrollView
        app:layout_constraintTop_toBottomOf="@id/include_titles"
        app:layout_constraintBottom_toTopOf="@id/bottom_music"
        android:layout_width="match_parent"
        android:layout_height="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toBottomOf="@id/include_titles"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_marginHorizontal="16dp"
            android:id="@+id/top_index"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_track"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/sl_text"
                    android:src="@mipmap/home_tracks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_below="@id/sl_text"
                    android:layout_centerHorizontal="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tracks"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_marginHorizontal="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_play_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/url"
                    android:src="@mipmap/home_playlists"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playlists"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    />
            </RelativeLayout>


            <RelativeLayout
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_albums"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/album"
                    android:src="@mipmap/home_albums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Albums"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    />
            </RelativeLayout>

            <RelativeLayout
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_styles"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/styles"
                    android:src="@mipmap/home_styles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/styles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Styles"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    />
            </RelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:id="@+id/for_title"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Must-Hear Albums"
            android:textColor="#FFFFFFFF"
            app:layout_constraintTop_toBottomOf="@id/top_index"
            android:layout_marginTop="15dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp"
            android:textSize="16sp"
            />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:id="@+id/album_collect"
            app:layout_constraintTop_toBottomOf="@id/for_title"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_al1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/al_one"
                    android:src="@mipmap/al1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:tag="-1"
                    android:id="@+id/al1_txt"
                    android:lines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="8dp"
                    android:layout_below="@id/al_one"
                    android:layout_centerHorizontal="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_marginHorizontal="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_al2"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/al2"
                    android:src="@mipmap/al2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:tag="-1"
                    android:lines="1"
                    android:ellipsize="end"
                    android:id="@+id/al2_txt"
                    android:layout_marginTop="8dp"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/al2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    />
            </RelativeLayout>


            <RelativeLayout
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_al3"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/al3"
                    android:src="@mipmap/al3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:tag="-1"
                    android:id="@+id/al3_txt"
                    android:layout_marginTop="8dp"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/al3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:lines="1"
                    android:ellipsize="end"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    />
            </RelativeLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/home_content_ads"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/album_collect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.extraordinary.interstings.studios.goodads.CommonWeavesView
                android:layout_marginTop="25dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/home_bans"
                android:layout_width="match_parent"
                app:gnt_template_type="@layout/top_view_home_ban"
                android:layout_height="wrap_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/your_txt"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Artists"
            android:textColor="#FFFFFFFF"
            app:layout_constraintTop_toBottomOf="@id/home_content_ads"
            android:layout_marginTop="15dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp"
            android:textSize="16sp"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:visibility="gone"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/your_txt"
            android:id="@+id/no_content_pic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/empty_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/add_music"
                />
            <TextView
                android:id="@+id/btn_feed"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="92dp"
                android:layout_width="match_parent"
                android:text="No music files"
                android:gravity="center"
                android:textColor="#808080"
                android:textSize="16sp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/empty_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginBottom="15dp"
            app:layout_constraintTop_toBottomOf="@id/your_txt"
            android:id="@+id/recycle_hislist"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:background="#D9FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/bottom_music"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            >
            <com.airbnb.lottie.LottieAnimationView
                android:layout_marginStart="-20dp"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/music"
                android:layout_width="wrap_content"
                app:lottie_imageAssetsFolder="images"
                app:lottie_loop="true"
                app:lottie_fileName="play.json"
                android:layout_height="wrap_content"
                />
            <com.extraordinary.weaves.tendency.MarqueeTextView
                android:layout_centerVertical="true"
                android:layout_marginStart="-30dp"
                android:layout_toEndOf="@id/music"
                android:id="@+id/tv_home_bottom_music_name"
                android:layout_width="wrap_content"
                android:text="@string/app_name"

                android:layout_marginEnd="15dp"
                android:ellipsize="end"
                android:layout_toStartOf="@id/fl_home_bottom_play_pause"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:textColor="@color/black" />

            <ImageView
                android:layout_marginEnd="24dp"
                android:id="@+id/btn_home_bottom_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@mipmap/ic_bottom_bar_playlist"
                />



            <RelativeLayout
                android:padding="5dp"
                android:id="@+id/fl_home_bottom_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:layout_toStartOf="@id/btn_home_bottom_menu">

                <ImageView
                    android:visibility="gone"
                    android:layout_centerVertical="true"
                    android:id="@+id/btn_home_bottom_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_bottom_bar_pause"/>

                <ImageView
                    android:layout_centerVertical="true"
                    android:id="@+id/btn_home_bottom_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_bottom_bar_play"
                    />
            </RelativeLayout>

        </RelativeLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
