<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@mipmap/home_bg"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">
    <include android:id="@+id/include_titles"
        layout="@layout/main_include" />
    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toBottomOf="@id/include_titles"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_marginBottom="32dp"
            android:layout_marginHorizontal="16dp"
            android:id="@+id/top_index"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_track"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/sl_text"
                    android:src="@mipmap/s_track"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_below="@id/sl_text"
                    android:layout_centerHorizontal="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tracks"
                    android:textColor="#FFF6F6"
                    android:textSize="12sp"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_marginHorizontal="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_play_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/url"
                    android:src="@mipmap/s_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playlists"
                    android:textColor="#FFF6F6"
                    android:textSize="12sp"
                    />
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_albums"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/albums"
                    android:src="@mipmap/s_albums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/albums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Albums"
                    android:textColor="#FFF6F6"
                    android:textSize="12sp"
                    />
            </RelativeLayout>

            <RelativeLayout
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_artist"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/artist"
                    android:src="@mipmap/s_art"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Artists"
                    android:textColor="#FFF6F6"
                    android:textSize="12sp"
                    />
            </RelativeLayout>

            <RelativeLayout
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:id="@+id/rl_styles"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerHorizontal="true"
                    android:id="@+id/styles"
                    android:src="@mipmap/s_styles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/styles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Styles"
                    android:textColor="#FFF6F6"
                    android:textSize="12sp"
                    />
            </RelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <ImageView
            android:layout_marginTop="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/pic"
            android:src="@mipmap/empty_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/txt"
            app:layout_constraintTop_toBottomOf="@id/pic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No lyrics found"
            android:textColor="#FF808080"
            android:textSize="16sp"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/home_content_ads"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.extraordinary.interstings.studios.goodads.CommonWeavesView
                android:layout_marginTop="25dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/home_bans"
                android:layout_width="match_parent"
                app:gnt_template_type="@layout/top_view_home_ban"
                android:layout_height="wrap_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginTop="21dp"
            android:layout_marginHorizontal="15dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="24dp"
            app:layout_constraintTop_toBottomOf="@id/home_content_ads"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/lyric_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No lyrics available, but the melody still flows. Keep enjoying the music and immerse yourself in every note with Melodi Music."
                android:textColor="#FF808080"
                android:textSize="14sp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
