<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_toolbar_card"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/notif_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="@null" android:src="@mipmap/lauch_logo" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/notif_toolbar_quick_mix" android:textColor="@color/notif_toolbar_play" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/notif_toolbar_brand_title" android:textColor="@color/notif_toolbar_text" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_notif_toolbar_chevron" />
    </LinearLayout>

    <include layout="@layout/notification_toolbar_collapsed" />
</LinearLayout>
